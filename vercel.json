{
  "headers": [
    {
      "source": "/Loadstring.lua",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/session/init",   "destination": "/api/secure?__route=session_init" },
    { "source": "/api/payload.enc",    "destination": "/api/secure?__route=payload_enc" },
    { "source": "/api/asset/kitagawa", "destination": "/api/secure?__route=asset_kitagawa" }
  ]
}
