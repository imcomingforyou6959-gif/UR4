    { "source": "/api/loader.enc",       "destination": "/api/secure?__route=loader_enc" },
    { "source": "/api/payload.enc",      "destination": "/api/secure?__route=payload_enc" },
    { "source": "/api/asset/kitagawa",   "destination": "/api/secure?__route=asset_kitagawa" },
